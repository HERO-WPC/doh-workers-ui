# tools/.monitor.env.example — 复制成 tools/.monitor.env 后填真实值
#
#   cp tools/.monitor.env.example tools/.monitor.env
#
# .monitor.env 已被 .gitignore 排除;真实域名/路径只写在那里,不要写回源码。
# monitor.py 启动时会校验这些值不是下面的占位符,否则直接退出(它要写 DNS)。
#
# 占位符统一以 "your-" 开头,便于源码侧识别。

# DoH 主域(monitor 自己管它的 A 记录,--count 条)
DOH_HOST=your-doh-domain.example
DOH_PATH=/your-doh-path/dns-query

# Web 面板登录路径:访问 /<该值> 即种 Cookie 进入(越难猜越安全)
AUTH_PATH=your-auth-path

# 域名端到端监控列表(逗号分隔)
MONITOR_DOMAINS=your-domain.example

# 反代 IP 巡检域名 + 其 zone id(留空=按域名自动匹配 token 可见的 zone)
NTPRXX_DOMAIN=your-domain.example
CF_ZONE_ID=
